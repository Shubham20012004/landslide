# Copy to backend/.env to override defaults. Never commit the real .env.

# SQLite database file (default: backend/data/landslide.db)
# DATABASE_URL=sqlite:///C:/path/to/landslide.db

# Browser origins allowed to call the API (comma-separated). The Vite dev server proxies /api,
# so this only matters if you open the frontend from another origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# CSV upload limits
MAX_UPLOAD_MB=50
MAX_DATASET_ROWS=1000000

# Logging and background tasks
LOG_LEVEL=INFO
ENABLE_BACKGROUND_TASKS=true
MONITOR_INTERVAL_SEC=5

# Upload / artifact folders (defaults: backend/uploads, backend/artifacts)
# UPLOAD_DIR=
# ARTIFACT_DIR=
